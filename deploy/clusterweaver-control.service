[Unit]
Description=ClusterWeaver web application
After=network.target

[Service]
Type=simple
User=clusterweaver
Group=clusterweaver
WorkingDirectory=/opt/clusterweaver/app
EnvironmentFile=/etc/clusterweaver/clusterweaver.env
ExecStart=/opt/clusterweaver/venv/bin/gunicorn --no-control-socket --workers 2 --timeout 150 --graceful-timeout 30 --bind 0.0.0.0:5000 --access-logfile - --error-logfile - run:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clusterweaver

[Install]
WantedBy=multi-user.target
