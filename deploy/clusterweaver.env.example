# Install the real file as /etc/clusterweaver/clusterweaver.env with mode 0600.
CLUSTERWEAVER_SECRET_KEY=replace-with-a-long-random-value
CLUSTERWEAVER_DATABASE_URL=sqlite:////var/www/html/ClusterWeaver/data/clusterweaver.db
CLUSTERWEAVER_PROJECTS_ROOT=/var/www/html/ClusterWeaver/data/projects
# Initial node password; keep only in the installed 0600 environment file.
CLUSTERWEAVER_SSH_BOOTSTRAP_PASSWORD=replace-with-the-initial-node-password
