CLUSTERWEAVER_SECRET_KEY=GENERATED_BY_INSTALLER
CLUSTERWEAVER_LOGIN_USERNAME=admin
CLUSTERWEAVER_LOGIN_PASSWORD=changeme
CLUSTERWEAVER_DATABASE_URL=sqlite:////var/lib/clusterweaver/data/clusterweaver.db
CLUSTERWEAVER_PROJECTS_ROOT=/var/lib/clusterweaver/data/projects
CLUSTERWEAVER_PROJECT_IMPORT_ROOT=/var/lib/clusterweaver/data/Project-Import
CLUSTERWEAVER_SSH_BOOTSTRAP_PASSWORD=
CLUSTERWEAVER_SSH_SOURCE_IP=
# Optional override; default is the ssh_keys sibling of PROJECTS_ROOT.
# CLUSTERWEAVER_SSH_KEYS_ROOT=/var/lib/clusterweaver/data/ssh_keys
