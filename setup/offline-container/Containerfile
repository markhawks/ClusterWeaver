FROM registry.access.redhat.com/ubi10/ubi:latest AS builder

RUN dnf install -y python3 python3-pip python3-devel gcc openssl-devel libffi-devel \
    && dnf clean all
COPY setup/offline-container/requirements-runtime.txt /tmp/requirements-runtime.txt
RUN python3 -m venv /opt/clusterweaver-venv \
    && /opt/clusterweaver-venv/bin/python -m pip install --upgrade pip \
    && /opt/clusterweaver-venv/bin/python -m pip install --no-cache-dir -r /tmp/requirements-runtime.txt

FROM registry.access.redhat.com/ubi10/ubi:latest

RUN dnf install -y python3 git \
    && dnf clean all \
    && groupadd --gid 10001 clusterweaver \
    && useradd --uid 10001 --gid 10001 --home-dir /var/lib/clusterweaver --create-home --shell /sbin/nologin clusterweaver
COPY --from=builder /opt/clusterweaver-venv /opt/clusterweaver-venv
WORKDIR /opt/clusterweaver/app
COPY --chown=root:root alembic.ini run.py config.py requirements.txt LICENSE README.md CHANGELOG.md ./
COPY --chown=root:root clusterweaver ./clusterweaver
COPY --chown=root:root cluster_templates ./cluster_templates
COPY --chown=root:root migrations ./migrations
COPY --chown=root:root setup/offline-container/container-entrypoint.sh /usr/local/bin/clusterweaver-entrypoint
COPY --chown=root:root setup/offline-container/container-healthcheck.sh /usr/local/bin/clusterweaver-healthcheck
RUN chmod 0755 /usr/local/bin/clusterweaver-entrypoint /usr/local/bin/clusterweaver-healthcheck \
    && install -d -o 10001 -g 10001 -m 0755 /var/lib/clusterweaver/data/projects

ENV PATH=/opt/clusterweaver-venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    CLUSTERWEAVER_DATABASE_URL=sqlite:////var/lib/clusterweaver/data/clusterweaver.db \
    CLUSTERWEAVER_PROJECTS_ROOT=/var/lib/clusterweaver/data/projects \
    CLUSTERWEAVER_HOST=0.0.0.0 \
    CLUSTERWEAVER_PORT=5000
USER 10001:10001
VOLUME ["/var/lib/clusterweaver/data"]
EXPOSE 5000
ENTRYPOINT ["/usr/local/bin/clusterweaver-entrypoint"]
