[Unit]
Description=ClusterWeaver offline container
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/clusterweaver:0.1.6
ContainerName=clusterweaver
PublishPort=5000:5000
Volume=/var/lib/clusterweaver/data:/var/lib/clusterweaver/data:Z
EnvironmentFile=/etc/clusterweaver/clusterweaver.env
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all
HealthCmd=/usr/local/bin/clusterweaver-healthcheck
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=20s
HealthRetries=3

[Service]
Restart=on-failure
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
